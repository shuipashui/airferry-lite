<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/af_bg"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AirFerry Lite"
            android:textColor="@color/af_text"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="4dp"
            android:text="相机"
            android:textColor="@color/af_muted"
            android:textSize="11sp" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/fpsGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">
            <Button
                android:id="@+id/fps30"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="40dp"
                android:text="30"
                android:textSize="11sp" />
            <Button
                android:id="@+id/fps60"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="40dp"
                android:text="60"
                android:textSize="11sp" />
            <Button
                android:id="@+id/fps120"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="40dp"
                android:text="120"
                android:textSize="11sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:text="点「接收文件」开始扫描"
        android:textColor="@color/af_text"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/idlePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/af_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="相机在点接收后才打开，收完进入预览。"
                android:textColor="@color/af_muted"
                android:textSize="13sp" />
            <Button
                android:id="@+id/startReceiveButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:minWidth="160dp"
                android:text="接收文件"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/af_panel"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">
                <TextView
                    android:id="@+id/resultNames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="6dp"
                    android:padding="12dp"
                    android:textColor="@color/af_text"
                    android:textIsSelectable="true"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </ScrollView>
            <TextView
                android:id="@+id/resultMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingTop="8dp"
                android:textColor="@color/af_muted"
                android:textSize="13sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp">
                <Button
                    android:id="@+id/resultSaveButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="保存文件"
                    android:textSize="13sp" />
                <Button
                    android:id="@+id/continueReceiveButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="继续接收"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/restartingPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/af_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在释放相机"
                android:textColor="@color/af_text"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/restartCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="2"
                android:textColor="@color/af_accent"
                android:textSize="64sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="秒后重新扫描"
                android:textColor="@color/af_muted"
                android:textSize="15sp" />
            <ProgressBar
                android:id="@+id/restartProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="28dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/af_accent" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="请继续对准电脑二维码"
                android:textColor="@color/af_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/scanMetaRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/fileText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="等待文件"
            android:textColor="@color/af_text"
            android:textSize="12sp" />
        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="72dp"
            android:text="保存"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/af_accent" />

    <TextView
        android:id="@+id/speedText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="2dp"
        android:text="实时 — · 平均 —"
        android:textColor="@color/af_text"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/missingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="缺失片段：—"
        android:textColor="@color/af_muted"
        android:textSize="11sp" />

    <ScrollView
        android:id="@+id/diagnosticsScroll"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@color/af_panel"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:padding="4dp"
        android:scrollbars="vertical">
        <TextView
            android:id="@+id/diagnosticsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="诊断：等待开始扫描"
            android:textColor="@color/af_text"
            android:textIsSelectable="true"
            android:textSize="9sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">
        <Button
            android:id="@+id/copyDiagnosticsButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="复制诊断"
            android:textSize="12sp" />
        <Button
            android:id="@+id/resetButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="清空重收"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
